# Copy to .env and fill in your values

# Email settings (uses Gmail — create an App Password at myaccount.google.com/apppasswords)
EMAIL_FROM=your.gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=your.gmail@gmail.com

# Search filters
MIN_ROOMS=2
MAX_RENT=2500
# Comma-separated districts to include (leave empty for all Berlin)
# Example: Prenzlauer Berg,Friedrichshain,Mitte,Pankow
DISTRICTS=

# WBS requirement: "required", "not_required", or "any"
WBS=any
